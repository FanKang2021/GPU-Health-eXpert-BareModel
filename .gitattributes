# 强制所有文本文件使用 LF / normalize text files to LF
* text=auto eol=lf

*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf

# 二进制文件不转换 / binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.tgz binary
nvbandwidth binary
p2pBandwidthLatencyTest binary